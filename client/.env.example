# Client Environment Configuration (Public Variables only)
VITE_API_URL=http://localhost:3001/api

# Firebase Public Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Audit record retention (US-028 / NR-023). Leave empty until the team approves a period;
# then set a whole number of days (1-3650). Records older than this are marked "Past retention".
VITE_AUDIT_RETENTION_DAYS=

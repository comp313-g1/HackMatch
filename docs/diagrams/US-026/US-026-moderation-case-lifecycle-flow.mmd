%%{init: {"theme":"base","themeVariables":{"background":"#ffffff","primaryTextColor":"#1f2937","lineColor":"#4b5563","edgeLabelBackground":"#ffffff","fontFamily":"Arial, sans-serif"},"flowchart":{"useMaxWidth":true,"htmlLabels":true,"curve":"basis","nodeSpacing":46,"rankSpacing":64,"padding":14}}}%%
flowchart TD
    ACCESS{"Authenticated, MFA-complete,<br/>active stored ADMIN?"}:::decision
    DENIED["401 / 403 denied<br/>No moderation data or mutation"]:::denied
    TARGET{"Supported target resolves?<br/>team, profile, or flagged URL"}:::decision
    INVALID["400 / 404 safe failure<br/>Preserve submitted form values"]:::denied
    OPEN(["Open case<br/>Reason, actor, target type/ID,<br/>report count, created timestamp"]):::team
    DECIDE{"Reasoned ADMIN decision"}:::decision
    DISMISS["Dismiss<br/>No content mutation"]:::internal
    REDACT["Redact<br/>Team pitch or profile handle"]:::team
    WARN["Warn<br/>Set Warned and notify owner"]:::decision
    HIDE["Hide<br/>Set Hidden and notify owner"]:::danger
    URL["Disable URL<br/>Remove team link and add notice"]:::danger
    AUDIT["Append safe action record<br/>Actor, target, action, reason,<br/>outcome, summary, UTC time"]:::success
    DISMISSED(["Dismissed<br/>Terminal case state"]):::internal
    RESOLVED(["Resolved<br/>Terminal case state"]):::success
    DISCOVERY["Discovery filters exclude<br/>hidden teams and profiles"]:::team
    REPEAT["Repeated decision"]:::decision
    CLOSED["409 CASE_CLOSED<br/>No second decision"]:::denied
    POLY["Polymorphic target_id<br/>Resolved by application logic<br/>No direct target FK"]:::internal
    NONATOMIC["Implementation caveat<br/>Effect, alert, audit, and case close<br/>are not one transaction"]:::danger

    ACCESS -->|"No"| DENIED
    ACCESS -->|"Yes"| TARGET
    TARGET -->|"No"| INVALID
    TARGET -->|"Yes"| OPEN
    POLY -.-> TARGET
    OPEN --> DECIDE
    DECIDE --> DISMISS
    DECIDE --> REDACT
    DECIDE --> WARN
    DECIDE --> HIDE
    DECIDE --> URL
    DISMISS --> AUDIT
    REDACT --> AUDIT
    WARN --> AUDIT
    HIDE --> AUDIT
    URL --> AUDIT
    AUDIT -->|"dismiss"| DISMISSED
    AUDIT -->|"all enforcement actions"| RESOLVED
    HIDE --> DISCOVERY
    RESOLVED --> REPEAT
    DISMISSED --> REPEAT
    REPEAT --> CLOSED
    NONATOMIC -.-> AUDIT


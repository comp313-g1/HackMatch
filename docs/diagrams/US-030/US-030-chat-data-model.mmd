title: "HackMatch — US-030: Participant Chat Forums and Messaging — Data Model"
---
%%{init: {"theme":"base","themeVariables":{"background":"#ffffff","primaryColor":"#e8f1ff","primaryTextColor":"#1f2937","primaryBorderColor":"#3b82f6","lineColor":"#4b5563","tertiaryColor":"#f1e8ff","fontFamily":"Arial, sans-serif"},"er":{"useMaxWidth":true,"diagramPadding":24,"layoutDirection":"LR","minEntityWidth":280,"minEntityHeight":75,"entityPadding":16,"stroke":"#4b5563","fill":"#ffffff","fontSize":14}}}%%
erDiagram
    direction LR

    PARTICIPANT ||--o| PROFILE : has
    PARTICIPANT ||--o{ CHAT_CHANNEL : creates
    PARTICIPANT ||--o{ CHAT_MESSAGE : authors
    CHAT_CHANNEL ||--o{ CHAT_MESSAGE : contains

    PARTICIPANT["participants (presence_status from 0042)"] {
        uuid id PK
        string role
        boolean is_verified "Existing access gate"
        boolean is_suspended "Existing access gate"
        string presence_status "Explicit choice, default Invisible"
    }

    PROFILE["participant_profiles — existing"] {
        uuid participant_id PK, FK
        string handle "Chat display identity"
    }

    CHAT_CHANNEL["chat_channels (0041)"] {
        uuid id PK
        string title "Required, max 120"
        string description "Required, max 2,000"
        uuid created_by FK
        datetime created_at
        datetime updated_at
    }

    CHAT_MESSAGE["chat_messages (0041)"] {
        uuid id PK
        uuid channel_id FK
        uuid author_id FK
        text body "Nonblank, max 4,000"
        datetime created_at "UTC timestamp"
    }

    classDef identity fill:#e8f1ff,stroke:#3b82f6,color:#172554
    classDef persistence fill:#e8f7ed,stroke:#3a9b5f,color:#123d24
    class PARTICIPANT,PROFILE identity
    class CHAT_CHANNEL,CHAT_MESSAGE persistence


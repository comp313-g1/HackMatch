flowchart LR
    START(["Verified PART creates team<br/>without selecting an event"]):::identity
    SHADOW["Bind Internal Shadow Event<br/>Backend implementation detail"]:::internal
    OPEN["Open / Mutable<br/>Creator is confirmed Owner<br/>Default capacity 4"]:::team
    EDIT["Listing or vacancy changed<br/>Capacity invariant retained"]:::team
    MEMBER["Non-owner removed or leaves<br/>Capacity reopens<br/>Team remains Open"]:::team
    LOCKED["Locked<br/>Roster finalized<br/>Ordinary mutations rejected"]:::success
    DISBANDED["Disbanded<br/>Memberships released<br/>Requests canceled"]:::danger
    OWNER_DENIED["Owner leave rejected<br/>Owner must disband"]:::denied
    EXPIRED["Open but not mutable<br/>Current code: shadow event expired<br/>or is not Published"]:::warning
    REJECT["409 mutation rejection<br/>No roster change"]:::denied

    START --> SHADOW
    SHADOW --> OPEN
    OPEN -->|"Edit listing / slots"| EDIT
    EDIT --> OPEN
    OPEN -->|"Remove / voluntary leave"| MEMBER
    MEMBER --> OPEN
    OPEN -->|"Owner attempts leave"| OWNER_DENIED
    OWNER_DENIED --> OPEN
    OPEN -->|"Lock valid 2–capacity roster"| LOCKED
    OPEN -->|"Owner disbands"| DISBANDED
    OPEN -->|"Current one-year scope ends"| EXPIRED
    LOCKED --> REJECT
    DISBANDED --> REJECT
    EXPIRED --> REJECT


%%{init: {"theme":"base","themeVariables":{"background":"#ffffff","primaryTextColor":"#1f2937","lineColor":"#4b5563","edgeLabelBackground":"#ffffff","fontFamily":"Arial, sans-serif"},"flowchart":{"useMaxWidth":true,"htmlLabels":true,"curve":"basis","nodeSpacing":48,"rankSpacing":66,"padding":14}}}%%
flowchart LR
    START(["Owner submits teamId, slotId, inviteeId<br/>No event selection"]):::identity
    GUARDS{"Owner, team, slot, invitee,<br/>LFT, membership, and quotas valid?"}:::decision
    LEGACY["Current RPC also checks<br/>Internal Shadow Event lifecycle<br/>and event-scoped membership"]:::warning
    REJECT["Rejected<br/>No invitation or quota use<br/>Explicit 400 / 403 / 409"]:::denied
    PENDING["Pending<br/>Invitation tied to one Open slot<br/>Expires exactly 48 hours after issue<br/>Consumes slot and invitee/team quotas"]:::team
    EXPIRED["Expired<br/>Clock reached expires_at<br/>Acceptance rejected<br/>Quota released"]:::internal
    OWNER_CANCEL["Canceled<br/>Owner canceled before response<br/>Both parties receive status<br/>Quota released"]:::danger
    SYSTEM_CANCEL["Canceled<br/>Slot filled or removed, team locked,<br/>full, or disbanded<br/>Reason remains visible"]:::danger
    DECLINED["Declined<br/>Invitee responds through US-019<br/>Quota released"]:::denied
    ACCEPTED["Accepted<br/>US-019 revalidates and commits<br/>membership plus slot fill"]:::success
    REPEAT["Repeated owner cancel<br/>Idempotent success<br/>No duplicate alerts"]:::internal

    START --> GUARDS
    LEGACY -.-> GUARDS
    GUARDS -->|"No"| REJECT
    GUARDS -->|"Yes"| PENDING
    PENDING -->|"48-hour clock"| EXPIRED
    PENDING -->|"Owner DELETE"| OWNER_CANCEL
    PENDING -->|"Slot / team closes"| SYSTEM_CANCEL
    PENDING -->|"Invitee declines"| DECLINED
    PENDING -->|"Invitee accepts"| ACCEPTED
    OWNER_CANCEL -->|"Repeat DELETE"| REPEAT


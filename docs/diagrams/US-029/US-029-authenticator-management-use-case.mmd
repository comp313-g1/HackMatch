    FUTURE(["Authenticator or recovery code<br/>at sign-in — not implemented"]):::internal

    subgraph SIGNIN["Existing sign-in boundary (US-003 / US-004)"]
        EMAIL(["Complete mandatory email OTP<br/>5 attempts / 15-minute lock"]):::identity
    end

    subgraph AUTH["US-029 owner-only authenticator controls"]
        VERIFY(["Verify identity again<br/>Firebase sign-in + email OTP"]):::usecase
        STATUS(["View secret-free<br/>authenticator status"]):::usecase
        SETUP(["Set up authenticator<br/>QR code or manual key"]):::usecase
        RESTART(["Restart lost pending setup"]):::usecase
        CONFIRM(["Confirm 6-digit code<br/>before activation"]):::success
        CODES(["Generate or regenerate<br/>10 single-use recovery codes"]):::persistence
        REPLACE(["Replace authenticator<br/>Rotate recovery codes on success"]):::persistence
        DISABLE(["Turn off authenticator<br/>Revoke codes, email OTP remains"]):::usecase
    end

    OWNER --> EMAIL --> STATUS
    OWNER -->|"Sign-in older than 10 minutes"| VERIFY
    VERIFY --> SETUP
    STATUS --> SETUP
    SETUP --> RESTART
    SETUP --> CONFIRM
    CONFIRM --> CODES
    CONFIRM --> REPLACE
    CONFIRM --> DISABLE

    RESTRICTED -->|"401 or 403<br/>no authenticator data"| STATUS
    OTHER -. "Foreign ids look nonexistent<br/>ADMIN has no bypass" .-> CONFIRM
    FUTURE -. "Every login still uses email OTP" .-> EMAIL


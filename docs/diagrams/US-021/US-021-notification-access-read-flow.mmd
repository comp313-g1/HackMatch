title: "HackMatch — US-021: Notification Center — Access and Read-State Flow"
---
%%{init: {"theme":"base","themeVariables":{"background":"#ffffff","primaryColor":"#e8f1ff","primaryTextColor":"#1f2937","primaryBorderColor":"#3b82f6","lineColor":"#4b5563","tertiaryColor":"#fff7d6","fontFamily":"Arial, sans-serif"},"flowchart":{"useMaxWidth":true,"htmlLabels":true,"curve":"basis","nodeSpacing":30,"rankSpacing":38,"padding":14}}}%%
flowchart LR
    subgraph GATE[Server authorization]
        direction TB
        A[Notification request or SSE connection]:::identity --> B{Firebase authenticated<br/>and MFA complete?}:::decision
        B -- No --> X[401 with no notification data]:::denied
        B -- Yes --> C{Active, verified PART?}:::decision
        C -- No --> Y[403 with no notification data]:::denied
        C -- Yes --> D[Derive participant ID<br/>from server session]:::identity
        D --> E{Requested operation}:::decision
    end

    subgraph FEED[Feed and navigation]
        direction TB
        F[Query participant-owned rows<br/>with newest-first keyset pagination]:::domain
        F --> G[Return safe feed and unread count]:::success
        G --> Q[Deep link re-fetches and<br/>re-authorizes its target]:::decision
        Q --> R[Stale or forbidden target fails safely]:::denied
        Q --> S[Authorized target view]:::success
        T[US-034 chat read cursors<br/>are a separate model]:::internal -. not part of US-021 .-> F
    end

    subgraph STREAM[Live delivery]
        direction TB
        H{Below participant<br/>stream limit?}:::decision
        H -- No --> Y2[403 with no stream data]:::denied
        H -- Yes --> I[Participant-scoped subscription<br/>with heartbeat and bounded lifetime]:::domain
        I --> G2[Deliver safe notification<br/>and fresh unread count]:::success
    end

    subgraph READ[Read-state changes]
        direction TB
        J[Mark-one RPC matches notification<br/>and participant IDs]:::domain --> K{Owned row found?}:::decision
        K -- No or foreign --> L[Same safe NOTIFICATION_NOT_FOUND]:::denied
        K -- Yes --> M[Set read_at once and return<br/>fresh caller unread count]:::success
        N[Mark-all RPC atomically updates<br/>only caller-owned unread rows]:::domain --> O[Return marked count<br/>and fresh unread count]:::success
    end

    E -- List or filter --> F
    E -- Open stream --> H
    E -- Mark one --> J
    E -- Mark all --> N

    classDef identity fill:#e8f1ff,stroke:#3b82f6,color:#172554
    classDef domain fill:#f1e8ff,stroke:#8b5cf6,color:#3b1d64
    classDef decision fill:#fff7d6,stroke:#d4a72c,color:#5f4700
    classDef success fill:#e8f7ed,stroke:#3a9b5f,color:#123d24
    classDef denied fill:#ffe8ee,stroke:#d94f70,color:#6f1733
    classDef internal fill:#f3f4f6,stroke:#6b7280,color:#374151,stroke-dasharray: 5 5


---
title: "HackMatch — US-018: Apply to Join a Team Vacancy — Application Lifecycle State Diagram"
---
%%{init: {"theme":"base","themeVariables":{"background":"#ffffff","primaryTextColor":"#1f2937","lineColor":"#4b5563","edgeLabelBackground":"#ffffff","fontFamily":"Arial, sans-serif"},"flowchart":{"useMaxWidth":true,"htmlLabels":true,"curve":"basis","nodeSpacing":48,"rankSpacing":66,"padding":14}}}%%
flowchart LR
    START(["Verified PART submits teamId, slotId,<br/>and optional message up to 250 chars<br/>No event selection"]):::identity
    PREFLIGHT["Express preflight<br/>Target-team membership exclusion<br/>Same-team duplicate check<br/>Platform-wide Pending count"]:::team
    ATOMIC["Current PostgreSQL RPC<br/>Locks applicant<br/>But checks shadow event lifecycle,<br/>event membership, and per-event count"]:::warning
    REJECT["Rejected<br/>No row or owner alert<br/>Draft remains visible"]:::denied
    PENDING["Pending Review<br/>Tied to one vacancy<br/>Visible in My Applications<br/>Consumes one quota position"]:::team
    WITHDRAWN["Withdrawn<br/>Applicant acts before decision<br/>Owner and applicant alerted<br/>Quota position released"]:::internal
    REPEAT["Repeated withdrawal<br/>Idempotent success"]:::internal
    DECLINED["Declined<br/>Owner decision through US-020<br/>Quota position released"]:::denied
    ACCEPTED["Accepted<br/>US-020 commits membership<br/>and fills the vacancy"]:::success
    CANCELED["Canceled<br/>Slot removed or filled, team locked,<br/>full, disbanded, or account action<br/>Quota position released"]:::danger
    REVIEW["Owner review projection<br/>Display name, handle, role,<br/>institution, skills, portfolios,<br/>and applicant message"]:::availability

    START --> PREFLIGHT
    PREFLIGHT -->|"Invalid or count at least 3"| REJECT
    PREFLIGHT -->|"Passes"| ATOMIC
    ATOMIC -->|"Legacy gate fails"| REJECT
    ATOMIC -->|"Insert succeeds"| PENDING
    PENDING -.-> REVIEW
    PENDING -->|"Applicant withdraws"| WITHDRAWN
    WITHDRAWN -->|"Repeat withdrawal"| REPEAT
    PENDING -->|"Owner declines"| DECLINED
    PENDING -->|"Owner approves"| ACCEPTED
    PENDING -->|"Slot / team / account closes"| CANCELED


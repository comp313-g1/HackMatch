%%{init: {"theme":"base","themeVariables":{"background":"#ffffff","primaryTextColor":"#1f2937","lineColor":"#4b5563","edgeLabelBackground":"#ffffff","fontFamily":"Arial, sans-serif"},"flowchart":{"useMaxWidth":true,"htmlLabels":true,"curve":"basis","nodeSpacing":48,"rankSpacing":66,"padding":14}}}%%
flowchart TD
    PENDING(["Pending invitation<br/>Addressed PART only<br/>Inside 48-hour window"]):::team
    DECISION{"Invitee decision?"}:::decision
    DECLINE["Declined<br/>No membership<br/>Vacancy remains Open<br/>LFT unchanged<br/>Owner alerted"]:::denied
    GUARDS{"Current account, team, vacancy,<br/>capacity, and target-team membership valid?"}:::decision
    CONFLICT["Rejected or conflict<br/>No partial placement<br/>Refresh current state"]:::danger
    LEGACY["Current SQL also checks<br/>Internal Shadow Event lifecycle<br/>and participant/event membership"]:::warning
    COMMIT["Atomic acceptance<br/>Invitation Accepted<br/>Membership Confirmed<br/>Vacancy Filled<br/>LFT cleared"]:::success
    CLEANUP["Placement cleanup<br/>Filled-slot requests canceled<br/>Full-team requests canceled<br/>Owner status persisted"]:::team
    MEMBER["Confirmed non-owner member<br/>Team still unlocked"]:::identity
    LEAVE{"Leave requested?"}:::decision
    OWNER["Owner cannot use Leave<br/>Disband flow required"]:::denied
    LOCKED["Locked or non-Open team<br/>Leave rejected"]:::danger
    LEFT["Membership Removed<br/>Capacity available again<br/>Owner alerted<br/>Canceled requests stay canceled"]:::success
    RESTORE["Legacy compatibility behavior<br/>Restores only matching shadow-event availability<br/>and requires its event to be recruiting"]:::warning

    PENDING --> DECISION
    DECISION -->|"Decline"| DECLINE
    DECISION -->|"Accept"| GUARDS
    LEGACY -.-> GUARDS
    GUARDS -->|"No"| CONFLICT
    GUARDS -->|"Yes"| COMMIT
    COMMIT --> CLEANUP
    CLEANUP --> MEMBER
    MEMBER --> LEAVE
    LEAVE -->|"No"| MEMBER
    LEAVE -->|"Actor owns team"| OWNER
    LEAVE -->|"Team locked"| LOCKED
    LEAVE -->|"Eligible non-owner"| LEFT
    RESTORE -.-> LEFT


flowchart TB
    Inputs([ReverseMatchInputs plus eligible team vacancy]):::identity
    Normalize["Normalize participant and required skills<br/>case-insensitive, single spaces, first spelling wins"]:::availability
    Skill["S: required-skill coverage<br/>role match times 1.2, capped at 1<br/>no required skills gives 1"]:::team
    Goal["G: same goal 1<br/>adjacent goals 0.5<br/>otherwise or missing 0"]:::team
    Hours["H: min participant over team hours, 1<br/>team request zero gives 1<br/>missing input gives 0"]:::team
    Combine["Score = 100 times average of S, G, H<br/>bound 0 through 100"]:::team
    Explain["Round matchPercent<br/>retain vacancy spelling for matched and missing tags<br/>return component explanations"]:::success
    Rank["Rank by unrounded score,<br/>matched-skill count, team name,<br/>then vacancy id"]:::success
    Service["getEligibleTeamRecommendations invokes<br/>rankTeamVacancies for eligible candidates"]:::success
    Contract["Safe scored DTO satisfies React contract<br/>rank, percentage, skill tags, explanations"]:::success
    Privacy["No email, Firebase identity,<br/>member details, or private profile fields"]:::internal

    Inputs --> Normalize
    Normalize --> Skill
    Normalize --> Goal
    Normalize --> Hours
    Skill --> Combine
    Goal --> Combine
    Hours --> Combine
    Combine --> Explain --> Rank --> Service --> Contract
    Privacy -.-> Explain

